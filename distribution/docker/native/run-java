# Launches the GraalVM native image of Druid in place of a JVM.
#
# This script replaces bin/run-java in the native Docker image. It accepts the command line that the JVM launcher
# receives from druid.sh, peon.sh and ForkingTaskRunner:
#
#   run-java [jvm-options...] -cp <classpath> org.apache.druid.cli.Main <druid-args...>
#
# and turns it into an invocation of the native binary:
#
#   druid [runtime-options...] [-Dkey=value...] <druid-args...>
#
# Translation rules:
#   - -D properties pass through. java.class.path is set to the -cp value so that PropertiesModule finds
#     common.runtime.properties and runtime.properties in the configuration directories, and so that forked peons
#     inherit the same class path.
#   - -Xmx, -Xms, -Xmn and -Xss pass through; the native runtime understands them.
#   - -XX: options pass through when the binary supports them (MaxDirectMemorySize, ActiveProcessorCount,
#     ExitOnOutOfMemoryError, ...). -XX:MaxRAMPercentage becomes -XX:MaximumHeapSizePercent. Unsupported options,
#     such as garbage collector selection, are dropped with a warning: an unknown -XX option is fatal for a native
#     binary.
#   - Module system options (--add-opens, ...) and other JVM-only options are dropped. The image was built with the
#     equivalents.
#   - Jars on the class path are ignored: every extension is compiled into the binary.
#   - log4j2.configurationFile defaults to the first log4j2.xml found in the configuration directories, because
#     Log4j cannot discover it on the class path of a native image.
#   - guice_bytecode_gen_option=DISABLED and fakeSpecialize=true are set unless given, because a native image cannot
#     define classes at run time.
#   - druid.indexer.runner.k8sAndWorker.http.httpClientType is forced to javaStandardHttp: the Kubernetes task runner's
#     Vert.x and OkHttp clients are not usable in the native image, only the JDK one. Druid lets system properties
#     override its properties files, so a different value in a properties file is overridden too, with a warning.
#
# JAVA_TOOL_OPTIONS and JDK_JAVA_OPTIONS are honoured the way a JVM would, by prepending them to the arguments.

set -eu

DRUID_NATIVE_BINARY="${DRUID_NATIVE_BINARY:-/opt/druid/bin/druid}"

warn() {
  echo "run-java: $*" >&2
}

fail() {
  warn "$*"
  exit 1
}

if [ ! -x "$DRUID_NATIVE_BINARY" ]; then
  fail "native binary $DRUID_NATIVE_BINARY is missing or not executable"
fi

# Names of the -XX options the binary understands, one per line, read lazily from its own help output.
supported_xx_options=""
is_supported_xx_option() {
  if [ -z "$supported_xx_options" ]; then
    supported_xx_options="$("$DRUID_NATIVE_BINARY" -XX:PrintFlags= 2>&1 \
      | sed -n -E 's/^ *-XX:[^A-Za-z]*([A-Za-z0-9]+).*/\1/p' | sort -u)"
    [ -n "$supported_xx_options" ] || fail "could not list the options supported by $DRUID_NATIVE_BINARY"
  fi
  printf '%s\n' "$supported_xx_options" | grep -q -x -- "$1"
}

# shellcheck disable=SC2086
set -- ${JAVA_TOOL_OPTIONS:-} ${JDK_JAVA_OPTIONS:-} "$@"

runtime_options=()
properties=()
app_args=()
class_path=""
main_class=""
has_log4j_config=0
has_guice_option=0
has_fake_specialize=0

while [ $# -gt 0 ]; do
  arg="$1"
  shift
  if [ -n "$main_class" ]; then
    app_args+=("$arg")
    continue
  fi
  case "$arg" in
    -cp|-classpath|--class-path)
      [ $# -gt 0 ] || fail "option $arg requires an argument"
      class_path="$1"
      shift
      ;;
    --class-path=*)
      class_path="${arg#*=}"
      ;;
    -Dlog4j2.configurationFile=*|-Dlog4j.configurationFile=*)
      has_log4j_config=1
      properties+=("$arg")
      ;;
    -Dguice_bytecode_gen_option=*)
      has_guice_option=1
      properties+=("$arg")
      ;;
    -DfakeSpecialize=*)
      has_fake_specialize=1
      properties+=("$arg")
      ;;
    -Ddruid.indexer.runner.k8sAndWorker.http.httpClientType=*)
      if [ "${arg#*=}" != javaStandardHttp ]; then
        warn "ignoring $arg: only the javaStandardHttp Kubernetes client is available in the native image"
      fi
      ;;
    -Djava.class.path=*)
      warn "ignoring $arg: java.class.path is taken from -cp"
      ;;
    -D*)
      properties+=("$arg")
      ;;
    -Xmx*|-Xms*|-Xmn*|-Xss*)
      runtime_options+=("$arg")
      ;;
    -XX:MaxRAMPercentage=*)
      percent="${arg#*=}"
      runtime_options+=("-XX:MaximumHeapSizePercent=${percent%%.*}")
      ;;
    -XX:+UseContainerSupport|-XX:-UseContainerSupport|-XX:+Use*GC|-XX:+UseCompactObjectHeaders|-XX:+UnlockExperimentalVMOptions|-XX:+UnlockDiagnosticVMOptions)
      # Container awareness is always on; the garbage collector and object layout are fixed at build time.
      ;;
    -XX:*)
      name="${arg#-XX:}"
      name="${name#[+-]}"
      name="${name%%=*}"
      if is_supported_xx_option "$name"; then
        runtime_options+=("$arg")
      else
        warn "ignoring $arg: not supported by the native image"
      fi
      ;;
    -server|-client|--add-opens=*|--add-exports=*|--add-modules=*|--add-reads=*|--enable-native-access=*|-Xshare:*)
      # Compiled into the image; nothing to do at run time.
      ;;
    --add-opens|--add-exports|--add-modules|--add-reads|--enable-native-access|--limit-modules|--module-path|-p|--upgrade-module-path|--patch-module)
      [ $# -gt 0 ] && shift
      ;;
    -jar)
      fail "running a jar is not supported by the native image"
      ;;
    -*)
      warn "ignoring $arg: not applicable to the native image"
      ;;
    *)
      main_class="$arg"
      ;;
  esac
done

[ -n "$main_class" ] || fail "no main class given"
if [ "$main_class" != "org.apache.druid.cli.Main" ]; then
  fail "only org.apache.druid.cli.Main is compiled into the native image, cannot run $main_class"
fi

# Configuration directories come from the class path. Globs such as lib/* name the jars compiled into the binary;
# any other jar cannot be loaded.
conf_dirs=()
IFS=':' read -r -a class_path_entries <<< "$class_path"
for entry in "${class_path_entries[@]}"; do
  if [ -z "$entry" ]; then
    continue
  elif [ -d "$entry" ]; then
    conf_dirs+=("$entry")
  elif [ -f "$entry" ]; then
    warn "ignoring class path entry $entry: jars cannot be added to the native image at run time"
  fi
done

if [ -n "$class_path" ]; then
  properties+=("-Djava.class.path=$class_path")
fi

if [ "$has_log4j_config" = 0 ]; then
  for dir in "${conf_dirs[@]}"; do
    if [ -f "$dir/log4j2.xml" ]; then
      properties+=("-Dlog4j2.configurationFile=$dir/log4j2.xml")
      break
    fi
  done
fi
[ "$has_guice_option" = 1 ] || properties+=("-Dguice_bytecode_gen_option=DISABLED")
[ "$has_fake_specialize" = 1 ] || properties+=("-DfakeSpecialize=true")

for dir in "${conf_dirs[@]}"; do
  for file in "$dir"/common.runtime.properties "$dir"/runtime.properties; do
    if [ -f "$file" ] && grep -q -E "^[[:space:]]*druid\\.indexer\\.runner\\.k8sAndWorker\\.http\\.httpClientType[[:space:]]*=[[:space:]]*[^[:space:]]" "$file" \
       && ! grep -q -E "^[[:space:]]*druid\\.indexer\\.runner\\.k8sAndWorker\\.http\\.httpClientType[[:space:]]*=[[:space:]]*javaStandardHttp[[:space:]]*$" "$file"; then
      warn "overriding druid.indexer.runner.k8sAndWorker.http.httpClientType from $file: only the javaStandardHttp Kubernetes client is available in the native image"
    fi
  done
done
properties+=("-Ddruid.indexer.runner.k8sAndWorker.http.httpClientType=javaStandardHttp")

exec "$DRUID_NATIVE_BINARY" "${runtime_options[@]}" "${properties[@]}" "${app_args[@]}"
