<!--
  Maven settings for the builds on the croct-custom-32 runner, which Maven Central rate-limits
  (docs/adr/0004-graalvm-native-image.md). Google's mirror of Central serves the same artifacts. The mirror's id is
  `central` because pull-deps resolves from a repository with that id, and Maven only reuses a local artifact for a
  repository with the id it was downloaded from.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>central</id>
      <mirrorOf>central,maven.org</mirrorOf>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
    </mirror>
  </mirrors>
</settings>
